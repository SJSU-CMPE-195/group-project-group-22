<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.sjsu.spring2026.group32</groupId>
    <artifactId>hardware-neural-network-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>software</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mockito.version>5.18.0</mockito.version>
        <serialcomm.version>[2.11.0]</serialcomm.version>
        <junit.version>5.10.0</junit.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <!--
                          @{argLine} is late-binding: JaCoCo's prepare-agent goal sets
                          the argLine property before the test phase runs, so the JaCoCo
                          -javaagent is automatically prepended here. The Mockito agent
                          is appended after it on the next line.
                        -->
                        <argLine>
                            @{argLine}
                            -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
                        </argLine>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>

                    <!--
                      Plugin-level excludes: applied to both the report and check goals.
                      Classes are excluded when they are not meaningfully testable:
                        - Swing UI components (require a display; logic is rendering, not business)
                        - Enums (auto-generated values()/valueOf() skew coverage metrics)
                        - Records / DTOs (auto-generated accessors, equals, hashCode, toString)
                        - HardwareSignalSource (tightly coupled to physical serial hardware)
                      Interfaces are omitted here because they produce no bytecode instructions
                      and therefore never appear in JaCoCo's instruction counter.
                    -->
                    <configuration>
                        <excludes>
                            <!--
                              Each pattern uses a trailing * to capture both the outer class
                              and any compiler-generated inner / anonymous classes
                              (e.g. PongGame$GameCanvas, BidirectionalTest$VoltageGraph).
                              Without the wildcard, JaCoCo only drops the outer class entry
                              while still counting all $ inner classes — which skews the ratio.
                            -->

                            <!-- Swing UI — require a real or virtual display to exercise meaningfully -->
                            <exclude>edu/sjsu/spring2026/group32/launcher/Launcher*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/launcher/SerialConnectionPanel*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/pong/ui/PongToolbar*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/pong/ui/Scoreboard*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/pong/PongGame*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/BidirectionalTest*.class</exclude>

                            <!-- Enums — only auto-generated switch/valueOf bytecode; logic tested via callers -->
                            <exclude>edu/sjsu/spring2026/group32/player/PlayerType*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/pong/PongAction*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/pong/PlayerVariant*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/sandbox/HitTheZoneAction*.class</exclude>

                            <!-- Records / DTOs — all methods are compiler-generated -->
                            <exclude>edu/sjsu/spring2026/group32/pong/PongState*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/sandbox/HitTheZoneState*.class</exclude>

                            <!-- Hardware-coupled — depends on physical serial device; not mockable at unit level -->
                            <exclude>edu/sjsu/spring2026/group32/hardware/HardwareSignalSource*.class</exclude>
                        </excludes>
                    </configuration>

                    <executions>
                        <!--
                          (1) prepare-agent: binds to initialize phase by default.
                          Injects the JaCoCo -javaagent into argLine so Surefire
                          picks it up via @{argLine} in the Surefire config above.
                        -->
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>

                        <!--
                          (2) report: generates HTML, XML, and CSV coverage reports
                          under target/site/jacoco/ after all tests complete.
                          Excluded classes (see plugin-level <configuration>) are
                          omitted from the report so the percentage reflects only
                          meaningfully testable code.
                        -->
                        <execution>
                            <id>jacoco-report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>

                        <!--
                          (3) check: enforces a minimum instruction coverage ratio.
                          Currently 0.00 so the build does not fail before tests exist.
                          TODO: raise to 0.80 once 80%+ coverage is achieved.
                        -->
                        <execution>
                            <id>jacoco-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>INSTRUCTION</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.00</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fazecast</groupId>
                <artifactId>jSerialComm</artifactId>
                <version>${serialcomm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>