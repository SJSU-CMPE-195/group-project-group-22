<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.sjsu.spring2026.group32</groupId>
    <artifactId>hardware-neural-network-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>software</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mockito.version>5.18.0</mockito.version>
        <serialcomm.version>[2.11.0]</serialcomm.version>
        <junit.version>5.10.0</junit.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <!--
                          @{argLine} is late-binding: JaCoCo's prepare-agent goal sets
                          the argLine property before the test phase runs, so the JaCoCo
                          -javaagent is automatically prepended here. The Mockito agent
                          is appended after it on the next line.
                        -->
                        <argLine>
                            @{argLine}
                            -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
                        </argLine>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <!--
                          Keep exclusions narrow so coverage still reflects real logic.
                          These patterns target manual-only UI/bootstrap code, trivial
                          DTO-style records/enums, the coverage marker annotation, and
                          the thin jSerialComm adapter.
                        -->
                        <excludes>
                            <exclude>edu/sjsu/spring2026/group32/annotations/GeneratedExcludeFromCoverage*.class</exclude>

                            <exclude>edu/sjsu/spring2026/group32/bidirectionaltest/BidirectionalTest*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/bidirectionaltest/ui/*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/pong/ui/PongFrame*.class</exclude>

                            <exclude>edu/sjsu/spring2026/group32/hardware/serial/RealSerialDevice*.class</exclude>

                            <exclude>edu/sjsu/spring2026/group32/player/model/PlayerType*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/launcher/model/LauncherProgram*.class</exclude>

                            <exclude>edu/sjsu/spring2026/group32/pong/model/PongAction*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/pong/model/PongGameState*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/pong/model/PongSnapshot*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/pong/model/PongState*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/pong/model/PongTickResult*.class</exclude>

                            <exclude>edu/sjsu/spring2026/group32/hitthezone/model/HitTheZoneAction*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/hitthezone/model/HitTheZoneActionEffect*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/hitthezone/model/HitTheZoneSnapshot*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/hitthezone/model/HitTheZoneState*.class</exclude>

                            <!-- Swing JFrame / JPanel shells with @GeneratedExcludeFromCoverage -->
                            <exclude>edu/sjsu/spring2026/group32/launcher/Launcher.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/launcher/Launcher$*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/launcher/ui/*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/hitthezone/HitTheZoneGame.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/hitthezone/HitTheZoneGame$*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/pong/PongGame.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/pong/PongGame$*.class</exclude>

                            <!-- Swing UI panels excluded per @GeneratedExcludeFromCoverage -->
                            <exclude>edu/sjsu/spring2026/group32/hitthezone/ui/HitTheZoneHudPanel.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/hitthezone/ui/HitTheZoneHudPanel$*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/hitthezone/ui/HitTheZoneTrackPanel.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/hitthezone/ui/HitTheZoneTrackPanel$*.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/hitthezone/ui/HitTheZoneControlPanel.class</exclude>
                            <exclude>edu/sjsu/spring2026/group32/hitthezone/ui/HitTheZoneControlPanel$*.class</exclude>

                        </excludes>
                    </configuration>

                    <executions>
                        <!--
                          (1) prepare-agent: binds to initialize phase by default.
                          Injects the JaCoCo -javaagent into argLine so Surefire
                          picks it up via @{argLine} in the Surefire config above.
                        -->
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>

                        <!--
                          (2) report: generates HTML, XML, and CSV coverage reports
                          under target/site/jacoco/ after all tests complete.
                          Excluded classes (see plugin-level <configuration>) are
                          omitted from the report so the percentage reflects only
                          meaningfully testable code.
                        -->
                        <execution>
                            <id>jacoco-report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>

                        <!--
                          (3) check: enforces a minimum instruction coverage ratio.
                          Currently 0.00 so the build does not fail before tests exist.
                          TODO: raise to 0.80 once 80%+ coverage is achieved.
                        -->
                        <execution>
                            <id>jacoco-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>INSTRUCTION</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.00</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fazecast</groupId>
                <artifactId>jSerialComm</artifactId>
                <version>${serialcomm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>